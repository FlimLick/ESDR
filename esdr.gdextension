[configuration]
entry_symbol = "esdr_library_init"
compatibility_minimum = "4.2"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/libesdr.so"
linux.release.x86_64 = "res://bin/libesdr.so"
linux.debug.arm64 = "res://bin/libesdr.so"
linux.release.arm64 = "res://bin/libesdr.so"
macos.debug = "res://bin/libesdr.dylib"
macos.release = "res://bin/libesdr.dylib"
windows.debug.x86_64 = "res://bin/esdr.dll"
windows.release.x86_64 = "res://bin/esdr.dll"
